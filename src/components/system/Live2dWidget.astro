---
// Optional Live2D mascot runtime (oh-my-live2d); mounted once in the persistent layout shell.
// The SDK never enters the bundle: the bootstrap script only injects scriptUrl
// (self-hosted under public/live2d/ by default) when live2dConfig resolves,
// and the stage container attaches to <body>, so it persists across Swup page swaps.
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type {
	Live2dRuntimeOptions,
	Live2dStatusBarOptions,
	Live2dTipsOptions,
	ResolvedLive2dOptions,
} from "@/types/live2dConfig";

interface Props {
	options: ResolvedLive2dOptions;
}

const { options } = Astro.props;

// SDK 地址：配置给了覆盖就用手写的，否则用随包分发的副本。
// 动态导入保持「关闭时零请求」——未启用时不会请求该资源，
// 且 bundler 解析出的 URL 在源码态与 npm 包态都成立（public/ 不随包发布）。
const live2dScriptUrl =
	options.scriptUrl ??
	(await import("../../assets/live2d/oml2d.min.js?url")).default;

// oml2d 自带文案是硬编码中文，绕过了主题 i18n 规则；这里按站点语言逐字段注入
// 问候语/复制提示/状态条文案，用户覆盖过的字段原样保留。整段只做浅拷贝拼装，
// 绝不改写 live2dConfig 单例对象（它是 content:export 差分对比的基准）。
const localizedOptions = (() => {
	const next: Live2dRuntimeOptions = { ...options.options };
	const tips: Live2dTipsOptions = { ...next.tips };
	tips.welcomeTips = {
		...tips.welcomeTips,
		message: {
			daybreak: i18n(I18nKey.live2dWelcomeDaybreak),
			morning: i18n(I18nKey.live2dWelcomeMorning),
			noon: i18n(I18nKey.live2dWelcomeNoon),
			afternoon: i18n(I18nKey.live2dWelcomeAfternoon),
			dusk: i18n(I18nKey.live2dWelcomeDusk),
			night: i18n(I18nKey.live2dWelcomeNight),
			lateNight: i18n(I18nKey.live2dWelcomeLateNight),
			weeHours: i18n(I18nKey.live2dWelcomeWeeHours),
			...tips.welcomeTips?.message,
		},
	};
	tips.copyTips = {
		...tips.copyTips,
		message: tips.copyTips?.message ?? [i18n(I18nKey.live2dCopyTip)],
	};
	next.tips = tips;
	const statusBar: Live2dStatusBarOptions = { ...next.statusBar };
	statusBar.switchingMessage ??= i18n(I18nKey.live2dStatusSwitching);
	statusBar.loadingMessage ??= i18n(I18nKey.live2dStatusLoading);
	statusBar.loadSuccessMessage ??= i18n(I18nKey.live2dStatusLoadSuccess);
	statusBar.loadFailMessage ??= i18n(I18nKey.live2dStatusLoadFail);
	statusBar.reloadMessage ??= i18n(I18nKey.live2dStatusReload);
	statusBar.restMessage ??= i18n(I18nKey.live2dStatusRest);
	next.statusBar = statusBar;
	return next;
})();

// oml2d 自己的定位逻辑会覆盖 stageStyle 的水平偏移，这里把配置里的
// 偏移值转成 !important 规则强制生效（如为 FAB 通道让位时必需）。
const stageStyle = localizedOptions.stageStyle;
const stageFixRules = [
	["right", stageStyle?.right],
	["left", stageStyle?.left],
	["bottom", stageStyle?.bottom],
]
	.filter(([, value]) => typeof value === "string" && value)
	.map(([prop, value]) => `#oml2d-stage{${prop}:${value}!important}`)
	.join("");
---

{stageFixRules && <style is:inline nonce={options.cspNonce} set:html={stageFixRules} />}

<script is:inline nonce={options.cspNonce} define:vars={{ live2dScriptUrl, live2dOptions: localizedOptions }}>
	(() => {
		if (window.__shironeLive2dBooted) return;
		window.__shironeLive2dBooted = true;

		const boot = () => {
			// 防御：SDK 脚本已存在（外部注入/重复挂载）则不重复注入
			if (document.querySelector("script[data-shirone-live2d]")) return;
			const script = document.createElement("script");
			script.src = live2dScriptUrl;
			script.async = true;
			script.dataset.shironeLive2d = "";
			script.onerror = () => {
				console.warn("[shirone] Live2D SDK 加载失败：", live2dScriptUrl);
			};
			script.onload = () => {
				try {
					const stage = window.OML2D?.loadOml2d?.(live2dOptions);
					if (stage && typeof stage.catch === "function") {
						stage.catch((error) => {
							console.warn("[shirone] Live2D 初始化失败：", error);
						});
					}
				} catch (error) {
					console.warn("[shirone] Live2D 初始化失败：", error);
				}
			};
			document.head.appendChild(script);
		};

		const schedule = () => {
			// 首屏资源（壁纸/字体/正文）优先：SDK 体积可观且非关键路径，
			// 延迟到浏览器空闲再注入（idle 上限 4s 兜底，老引擎退化为 2s 定时）
			if ("requestIdleCallback" in window) {
				window.requestIdleCallback(boot, { timeout: 4000 });
			} else {
				window.setTimeout(boot, 2000);
			}
		};
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", schedule, { once: true });
		} else {
			schedule();
		}

		// 舞台是装饰性内容（无交互控件、无 aria-live，菜单已禁用），从无障碍树隐藏，
		// 免得读屏器停在空画布上。代价：加载失败时 SDK 状态条里的「重新加载」按钮
		// 对读屏器不可见——装饰性挂件可接受。SDK 每次 reload 会重建舞台元素，
		// 故用观察器持续兜底（改属性不触发 childList，不会自激）。
		const markStageDecorative = (node) => {
			if (!(node instanceof Element)) return;
			const stage =
				node.id === "oml2d-stage"
					? node
					: node.querySelector("#oml2d-stage");
			if (stage) stage.setAttribute("aria-hidden", "true");
		};
		markStageDecorative(document.body);
		new MutationObserver((records) => {
			for (const record of records) {
				for (const node of record.addedNodes) markStageDecorative(node);
			}
		}).observe(document.body, { childList: true });
	})();
</script>
